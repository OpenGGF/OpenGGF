    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <testSourceDirectory>src/test/java</testSourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
            </resource>
            <resource>
                <directory>src/main/resources-filtered</directory>
                <filtering>true</filtering>
                <includes>
                    <include>version.properties</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <version>3.1.1</version>
                <configuration>
                    <descriptors>
                        <descriptor>src/assembly/openggf-jar-with-dependencies.xml</descriptor>
                    </descriptors>
                    <!-- MainClass in mainfest make a executable jar -->
                    <archive>
                        <manifest>
                            <addClasspath>true</addClasspath>
                            <mainClass>com.openggf.Engine</mainClass>
                        </manifest>
                    </archive>

                </configuration>
                <executions>
                    <execution>
                        <id>make-assembly</id>
                        <!-- bind to the packaging phase -->
                        <phase>package</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <!-- Install the repo's tracked commit-policy hooks for local development.
                 Points git at .githooks so the documentation/changelog gate runs on
                 local commits without each contributor configuring it by hand. Runs
                 early on every build; idempotent; a no-op outside a git checkout
                 (failonerror=false) so source-tarball/offline builds are unaffected. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>capture-git-build-identity</id>
                        <phase>initialize</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <exportAntProperties>true</exportAntProperties>
                            <target>
                                <exec executable="git" dir="${project.basedir}" outputproperty="openggf.git.commit.raw" failonerror="false">
                                    <arg value="rev-parse"/>
                                    <arg value="--short=9"/>
                                    <arg value="HEAD"/>
                                </exec>
                                <exec executable="git" dir="${project.basedir}" outputproperty="openggf.git.dirty.raw" failonerror="false">
                                    <arg value="status"/>
                                    <arg value="--porcelain"/>
                                </exec>
                                <condition property="openggf.git.commit" value="${openggf.git.commit.raw}" else="">
                                    <and>
                                        <isset property="openggf.git.commit.raw"/>
                                        <length string="${openggf.git.commit.raw}" when="greater" length="0"/>
                                    </and>
                                </condition>
                                <condition property="openggf.git.dirty" value="true" else="false">
                                    <and>
                                        <isset property="openggf.git.dirty.raw"/>
                                        <length string="${openggf.git.dirty.raw}" when="greater" length="0"/>
                                    </and>
                                </condition>
                            </target>
                        </configuration>
                    </execution>
                    <execution>
                        <id>install-git-hooks</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <exec executable="git" dir="${project.basedir}" failonerror="false">
                                    <arg value="config"/>
                                    <arg value="core.hooksPath"/>
                                    <arg value=".githooks"/>
                                </exec>
                                <!-- java.io.tmpdir for surefire forks; the JVM
                                     requires it to exist before it starts. -->
                                <mkdir dir="${project.build.directory}/test-tmp"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.11.0</version>
                <configuration>
                    <release>${maven.compiler.release}</release>
                </configuration>
            </plugin>

            <!-- Prepare and attach the exact @ModApi binary/Javadoc SDK surface. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.1.0</version>
                <executions>
                    <execution>
                        <id>prepare-openggf-mod-sdk</id>
                        <phase>prepare-package</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-cp</argument>
                                <classpath/>
                                <argument>com.openggf.tools.modsdk.ModApiSdkPackager</argument>
                                <argument>${project.build.outputDirectory}</argument>
                                <argument>${project.basedir}/src/main/java</argument>
                                <argument>${project.build.directory}/mod-sdk/classes</argument>
                                <argument>${project.build.directory}/mod-sdk/javadocs</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>verify-openggf-mod-sdk-artifacts</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>-cp</argument><classpath/>
                                <argument>com.openggf.tools.modsdk.ModSdkArtifactVerifier</argument>
                                <argument>${project.build.directory}/${project.build.finalName}.jar</argument>
                                <argument>${project.build.directory}/${project.build.finalName}-jar-with-dependencies.jar</argument>
                                <argument>${project.build.directory}/${project.build.finalName}-openggf-mod-sdk.jar</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.4.2</version>
                <executions>
                    <execution>
                        <id>default-jar</id>
                        <configuration>
                            <excludes>
                                <exclude>com/openggf/tools/modsdk/**</exclude>
                                <exclude>META-INF/openggf-mod-sdk/**</exclude>
                            </excludes>
                        </configuration>
                    </execution>
                    <execution>
                        <id>attach-openggf-mod-sdk</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/mod-sdk/classes</classesDirectory>
                            <classifier>openggf-mod-sdk</classifier>
                        </configuration>
                    </execution>
                    <execution>
                        <id>attach-openggf-mod-sdk-javadoc</id>
                        <phase>package</phase>
                        <goals><goal>jar</goal></goals>
                        <configuration>
                            <classesDirectory>${project.build.directory}/mod-sdk/javadocs</classesDirectory>
                            <classifier>openggf-mod-sdk-javadoc</classifier>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <!-- LWJGL/GLFW on macOS requires -XstartOnFirstThread (set via profile) -->
                    <!-- java.io.tmpdir must be set on the command line, not via
                         systemPropertyVariables: java.nio.file.TempFileHelper caches it
                         in a static initialiser that surefire's own early temp-file use
                         can trigger before those properties are applied.

                         Tests create temp files and directories in many places and not
                         all of them clean up. Pointed at the system temp directory that
                         accumulated ~1,800 stale directories and, where /tmp is a
                         RAM-backed tmpfs, eventually filled it and broke unrelated
                         features that legitimately need temporary space. Here the mess
                         is bounded, invisible to the rest of the machine, and removed by
                         `mvn clean`. Tests should still clean up after themselves; this
                         makes forgetting harmless rather than cumulative. -->
                    <argLine>${surefire.argLine} -Djava.io.tmpdir=${project.build.directory}/test-tmp</argLine>
                    <!-- Run test classes in parallel forked JVMs.
                         Thread-level parallelism is unsafe due to singleton state,
                         but process-level forks each get isolated singletons.
                         Default: 4 forks locally, 1 in CI (see ci profile). -->
                    <forkCount>${surefire.forkCount}</forkCount>
                    <reuseForks>true</reuseForks>
                    <systemPropertyVariables>
                        <!-- Architectural guard tests resolve source paths from the project root,
                             which surefire-launched forks inherit; pass it explicitly so IDE
                             runs from arbitrary working dirs also find the source tree. -->
                        <project.basedir>${project.basedir}</project.basedir>
                        <java.util.logging.config.file>${test.logging.config.file}</java.util.logging.config.file>
                        <slf4j.internal.verbosity>${test.slf4j.verbosity}</slf4j.internal.verbosity>
                    </systemPropertyVariables>
                    <!-- Exclude tests that require a GL context/display -->
                    <excludes>
                        <exclude>**/TestGraphicsManagerHeadless.java</exclude>
                        <exclude>**/VisualRegressionTest.java</exclude>
                        <exclude>**/VisualReferenceGenerator.java</exclude>
                        <exclude>**/TestAizFireCurtainGpuDiag.java</exclude>
                        <exclude>**/TestS3kSpecialStageResultsVisual.java</exclude>
                        <exclude>**/TestInstaShieldVisual.java</exclude>
                        <exclude>**/tests/trace/**/*.java</exclude>
                        <exclude>**/tests/trace/**/*TraceReplay.java</exclude>
                        <exclude>**/tests/trace/**/*ReplayBootstrap.java</exclude>
                        <exclude>**/tests/trace/s2/*Regression.java</exclude>
                    </excludes>
                </configuration>
            </plugin>

            <!--<plugin>-->
                <!--<groupId>org.apache.maven.plugins</groupId>-->
                <!--<artifactId>maven-jar-plugin</artifactId>-->
                <!--<configuration>-->
                    <!--<archive>-->
                        <!--<manifestFile>src/main/java/META-INF/MANIFEST.MF</manifestFile>-->
                    <!--</archive>-->
                <!--</configuration>-->
            <!--</plugin>-->
        </plugins>
    </build>

