<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.openggf</groupId>
    <artifactId>OpenGGF</artifactId>
    <version>0.6.prerelease</version>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>21</maven.compiler.release>
        <lwjgl.version>3.3.3</lwjgl.version>
        <joml.version>1.10.5</joml.version>
        <mockito.version>5.14.2</mockito.version>
        <slf4j.version>2.0.17</slf4j.version>
        <mockito.agent.path>"${settings.localRepository}/org/mockito/mockito-core/${mockito.version}/mockito-core-${mockito.version}.jar"</mockito.agent.path>
        <mockito.agent.argLine>-javaagent:${mockito.agent.path}</mockito.agent.argLine>
        <test.cds.argLine>-Xshare:off</test.cds.argLine>
        <test.logging.config.file>${project.basedir}/src/test/resources/quiet-logging.properties</test.logging.config.file>
        <test.slf4j.verbosity>ERROR</test.slf4j.verbosity>
        <surefire.argLine>${test.cds.argLine} ${mockito.agent.argLine} -Xmx1g</surefire.argLine>
        <surefire.forkCount>4</surefire.forkCount>
        <native.macos.package.skip>true</native.macos.package.skip>
    </properties>

    <!-- LWJGL native classifier profiles -->
    <profiles>
        <profile>
            <id>lwjgl-natives-linux</id>
            <activation>
                <os><family>unix</family><name>!Mac OS X</name></os>
            </activation>
            <properties>
                <lwjgl.natives>natives-linux</lwjgl.natives>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-macos</id>
            <activation>
                <os><family>mac</family></os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos</lwjgl.natives>
                <surefire.argLine>-XstartOnFirstThread ${test.cds.argLine} ${mockito.agent.argLine} -Xmx1g</surefire.argLine>
                <native.macos.package.skip>false</native.macos.package.skip>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-macos-arm64</id>
            <activation>
                <os><family>mac</family><arch>aarch64</arch></os>
            </activation>
            <properties>
                <lwjgl.natives>natives-macos-arm64</lwjgl.natives>
                <surefire.argLine>-XstartOnFirstThread ${test.cds.argLine} ${mockito.agent.argLine} -Xmx1g</surefire.argLine>
                <native.macos.package.skip>false</native.macos.package.skip>
            </properties>
        </profile>
        <profile>
            <id>lwjgl-natives-windows</id>
            <activation>
                <os><family>windows</family></os>
            </activation>
            <properties>
                <lwjgl.natives>natives-windows</lwjgl.natives>
            </properties>
        </profile>

        <!-- Fast local dev launcher: run the engine straight from target/classes
             without building the jar-with-dependencies. Activate explicitly:

               mvn -q -Pdev-run compile exec:exec

             This is what dev.cmd and dev.sh invoke. It skips the ~40s fat-jar
             assembly / mod-SDK / verify packaging that run.cmd and run.sh perform;
             use the full launcher when you need the distributable jar. The forked
             JVM args mirror those launchers. -->
        <profile>
            <id>dev-run</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <configuration>
                            <executable>java</executable>
                            <arguments>
                                <argument>--add-exports</argument>
                                <argument>java.base/java.lang=ALL-UNNAMED</argument>
                                <argument>--add-exports</argument>
                                <argument>java.desktop/sun.awt=ALL-UNNAMED</argument>
                                <argument>--add-exports</argument>
                                <argument>java.desktop/sun.java2d=ALL-UNNAMED</argument>
                                <argument>-XX:+UseG1GC</argument>
                                <argument>-XX:MaxGCPauseMillis=5</argument>
                                <argument>-classpath</argument>
                                <classpath/>
                                <argument>com.openggf.Engine</argument>
                            </arguments>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- CI/CD profile: low-memory, single-fork execution.
             Activated automatically when CI=true (GitHub Actions, GitLab CI, etc.)
             or manually via: mvn test -Pci

             Current release suite size requires a single 1GB fork in CI.
             Keeping one fork also avoids native-library races between test JVMs.
        -->
        <profile>
            <id>ci</id>
            <activation>
                <property>
                    <name>env.CI</name>
                    <value>true</value>
                </property>
            </activation>
            <properties>
                <surefire.argLine>${test.cds.argLine} ${mockito.agent.argLine} -Xmx1g</surefire.argLine>
                <surefire.forkCount>1</surefire.forkCount>
            </properties>
        </profile>

        <!-- Trace replay parity tests are intentionally separated from the
             default unit/integration suite. They depend on local ROM assets and
             currently include known parity gaps, so hiding one game-specific
             class in the default exclusions would make the gap misleading.

             Run explicitly with:
               mvn -Ptrace-replay test
        -->
        <profile>
            <id>trace-replay</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration combine.self="override">
                            <argLine>${surefire.argLine}</argLine>
                            <forkCount>${surefire.forkCount}</forkCount>
                            <reuseForks>true</reuseForks>
                            <systemPropertyVariables>
                                <java.util.logging.config.file>${test.logging.config.file}</java.util.logging.config.file>
                                <slf4j.internal.verbosity>${test.slf4j.verbosity}</slf4j.internal.verbosity>
                                <project.basedir>${project.basedir}</project.basedir>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/tests/trace/**/*.java</include>
                                <include>**/tests/trace/**/*TraceReplay.java</include>
                                <include>**/tests/trace/**/*ReplayBootstrap.java</include>
                                <include>**/tests/trace/s2/*Regression.java</include>
                            </includes>
                            <excludes>
                                <exclude>**/Debug*.java</exclude>
                                <exclude>**/*Debug*.java</exclude>
                                <exclude>**/*Probe.java</exclude>
                                <exclude>**/*Probe*.java</exclude>
                                <exclude>**/TestGraphicsManagerHeadless.java</exclude>
                                <exclude>**/VisualRegressionTest.java</exclude>
                                <exclude>**/VisualReferenceGenerator.java</exclude>
                                <exclude>**/TestAizFireCurtainGpuDiag.java</exclude>
                                <exclude>**/TestS3kSpecialStageResultsVisual.java</exclude>
                                <exclude>**/TestInstaShieldVisual.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- Known-red trace probes are excluded from blocking suites and run
             only when explicitly requested:
               mvn -Ptrace-diagnostics -Dtest=<DebugOrProbeClass> test
        -->
        <profile>
            <id>trace-diagnostics</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <version>3.2.5</version>
                        <configuration combine.self="override">
                            <argLine>${surefire.argLine}</argLine>
                            <forkCount>${surefire.forkCount}</forkCount>
                            <reuseForks>true</reuseForks>
                            <systemPropertyVariables>
                                <java.util.logging.config.file>${test.logging.config.file}</java.util.logging.config.file>
                                <slf4j.internal.verbosity>${test.slf4j.verbosity}</slf4j.internal.verbosity>
                                <project.basedir>${project.basedir}</project.basedir>
                            </systemPropertyVariables>
                            <includes>
                                <include>**/tests/trace/**/Debug*.java</include>
                                <include>**/tests/trace/**/*Probe*.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>

        <!-- GraalVM native-image build: mvn package -Pnative -DskipTests -->
        <profile>
            <id>native</id>
            <build>
                <plugins>
                    <!-- Extract LWJGL native libraries from classifier JARs.
                         In a native image there are no JARs to extract from at runtime,
                         so we bundle the .dylib/.so/.dll files alongside the executable. -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-dependency-plugin</artifactId>
                        <version>3.6.1</version>
                        <executions>
                            <execution>
                                <id>unpack-lwjgl-natives</id>
                                <phase>generate-resources</phase>
                                <goals><goal>unpack-dependencies</goal></goals>
                                <configuration>
                                    <includeGroupIds>org.lwjgl</includeGroupIds>
                                    <includeClassifiers>${lwjgl.natives}</includeClassifiers>
                                    <outputDirectory>${project.build.directory}/lwjgl-unpack</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <!-- Flatten extracted native libs into target/native-libs/ -->
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-antrun-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>flatten-native-libs</id>
                                <phase>process-resources</phase>
                                <goals><goal>run</goal></goals>
                                <configuration>
                                    <target>
                                        <mkdir dir="${project.build.directory}/native-libs"/>
                                        <copy todir="${project.build.directory}/native-libs" flatten="true">
                                            <fileset dir="${project.build.directory}/lwjgl-unpack">
                                                <include name="**/*.dylib"/>
                                                <include name="**/*.so"/>
                                                <include name="**/*.dll"/>
                                            </fileset>
                                        </copy>
                                        <!-- Also copy to target/ alongside the native binary
                                             so bare execution (target/OpenGGF) works -->
                                        <copy todir="${project.build.directory}" flatten="true">
                                            <fileset dir="${project.build.directory}/lwjgl-unpack">
                                                <include name="**/*.dylib"/>
                                                <include name="**/*.so"/>
                                                <include name="**/*.dll"/>
                                            </fileset>
                                        </copy>
                                        <!-- Copy config.yaml next to the native binary so it
                                             can be edited without rebuilding -->
                                        <copy file="${basedir}/src/main/resources/config.yaml"
                                              todir="${project.build.directory}"/>
                                    </target>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.graalvm.buildtools</groupId>
                        <artifactId>native-maven-plugin</artifactId>
                        <version>0.10.4</version>
                        <extensions>true</extensions>
                        <configuration>
                            <imageName>OpenGGF</imageName>
                            <mainClass>com.openggf.Engine</mainClass>
                            <fallback>false</fallback>
                            <buildArgs>
                                <buildArg>--initialize-at-run-time=org.lwjgl</buildArg>
                                <buildArg>--initialize-at-run-time=java.awt,javax.swing,sun.awt,sun.java2d,com.apple.laf</buildArg>
                                <buildArg>-march=compatibility</buildArg>
                            </buildArgs>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-native</id>
                                <goals><goal>compile-no-fork</goal></goals>
                                <phase>prepare-package</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <version>3.1.0</version>
                        <executions>
                            <execution>
                                <id>assemble-platform-package</id>
                                <phase>package</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <skip>${native.macos.package.skip}</skip>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>${basedir}/src/packaging/assemble-macos-app.sh</argument>
                                        <argument>${basedir}/target/OpenGGF</argument>
                                        <argument>${basedir}/target</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>

