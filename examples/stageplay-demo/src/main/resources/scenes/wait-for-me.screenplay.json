      "dialogue": [
        {
          "startFrame": 25,
          "endFrame": 150,
          "speakerActor": "tails",
          "text": "Other lift. Together, okay?",
          "x": 8,
          "y": 170,
          "width": 304,
          "height": 48,
          "typerId": "speech",
          "skinId": "tails"
        },
        {
          "startFrame": 160,
          "endFrame": 300,
          "speakerActor": "sonic",
          "text": "Race you there!",
          "x": 8,
          "y": 170,
          "width": 304,
          "height": 48,
          "typerId": "speech",
          "skinId": "sonic"
        },
        {
          "startFrame": 340,
          "endFrame": 520,
          "speakerActor": "tails",
          "text": "You forgot the \"together\" bit.",
          "x": 8,
          "y": 170,
          "width": 304,
          "height": 48,
          "typerId": "speech",
          "skinId": "tails"
        },
        {
          "startFrame": 550,
          "endFrame": 655,
          "speakerActor": "sonic",
          "text": "Oh. Coming back!",
          "x": 8,
          "y": 170,
          "width": 304,
          "height": 48,
          "typerId": "speech",
          "skinId": "sonic"
        },
        {
          "startFrame": 800,
          "endFrame": 1000,
          "speakerActor": "tails",
          "text": "Try counting us in this time.",
          "x": 8,
          "y": 170,
          "width": 304,
          "height": 48,
          "typerId": "speech",
          "skinId": "tails"
        },
        {
          "startFrame": 1010,
          "endFrame": 1150,
          "speakerActor": "sonic",
          "text": "One. Two. Three!",
          "x": 8,
          "y": 170,
          "width": 304,
          "height": 48,
          "typerId": "speech",
          "skinId": "sonic"
        },
        {
          "startFrame": 1240,
          "endFrame": 1385,
          "speakerActor": "tails",
          "text": "See? Teamwork.",
          "x": 8,
          "y": 170,
          "width": 304,
          "height": 48,
          "typerId": "speech",
          "skinId": "tails"
        },
        {
          "startFrame": 1395,
          "endFrame": 1550,
          "speakerActor": "sonic",
          "text": "My slowest personal best.",
          "x": 8,
          "y": 170,
          "width": 304,
          "height": 48,
          "typerId": "speech",
          "skinId": "sonic"
        }
