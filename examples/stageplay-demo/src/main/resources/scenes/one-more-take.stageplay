":"ROM_MUSIC","gameId":"s3k","soundId":1,"asset":"","gain":1.0},{"id":"retry.audio0","frame":2220,"kind":"ROM_MUSIC","gameId":"s3k","soundId":23,"asset":"","gain":1.0},{"id":"closing.audio0","frame":3060,"kind":"ROM_MUSIC","gameId":"s3k","soundId":1,"asset":"","gain":1.0}],"cameraEffects":[],"sceneChanges":[{"id":"mishap.change","frame":960,"set":{"gameId":"s3k","zone":11,"act":0,"romSha1":"","levelProject":""},"transition":"FADE_BLACK","durationFrames":12},{"id":"regroup.change","frame":1260,"set":{"gameId":"s3k","zone":0,"act":0,"romSha1":"","levelProject":""},"transition":"FADE_BLACK","durationFrames":12},{"id":"retry.change","frame":2220,"set":{"gameId":"s3k","zone":11,"act":1,"romSha1":"","levelProject":""},"transition":"FADE_BLACK","durationFrames":12},{"id":"closing.change","frame":3060,"set":{"gameId":"s3k","zone":0,"act":0,"romSha1":"","levelProject":""},"transition":"FADE_BLACK","durationFrames":12}],"dialogueTypers":[{"id":"pace","framesPerGrapheme":1,"punctuationPauseFrames":2,"spacePauseFrames":0}],"dialogueSkins":[],"dialogue":[{"id":"relay.dialogue0","startFrame":75,"endFrame":205,"speakerActor":"sonic","speakerName":"","text":"One more take. Keep it moving.","skinId":"","typerId":"pace","x":8,"y":170,"width":304,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"relay.dialogue1","startFrame":220,"endFrame":345,"speakerActor":"tails","speakerName":"","text":"I will hold the mark.","skinId":"","typerId":"pace","x":8,"y":170,"width":304,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"relay.dialogue2","startFrame":420,"endFrame":545,"speakerActor":"sonic","speakerName":"","text":"Trade places on my cue.","skinId":"","typerId":"pace","x":8,"y":170,"width":304,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"relay.dialogue3","startFrame":640,"endFrame":745,"speakerActor":"tails","speakerName":"","text":"Again. We are getting this.","skinId":"","typerId":"pace","x":8,"y":170,"width":304,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"relay.dialogue4","startFrame":850,"endFrame":945,"speakerActor":"sonic","speakerName":"","text":"Got it. Now the ring run.","skinId":"","typerId":"pace","x":8,"y":170,"width":304,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"mishap.dialogue0","startFrame":980,"endFrame":1075,"speakerActor":"sonic","speakerName":"","text":"That was the wrong floor.","skinId":"","typerId":"pace","x":184,"y":8,"width":128,"height":60,"portraitAsset":"","revealFrames":[]},{"id":"mishap.dialogue1","startFrame":1110,"endFrame":1245,"speakerActor":"tails","speakerName":"","text":"Air route!","skinId":"","typerId":"pace","x":8,"y":8,"width":128,"height":60,"portraitAsset":"","revealFrames":[]},{"id":"regroup.dialogue0","startFrame":1280,"endFrame":1338,"speakerActor":"tails","speakerName":"","text":"I will take the high mark.","skinId":"","typerId":"pace","x":8,"y":8,"width":304,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"regroup.dialogue1","startFrame":1525,"endFrame":1615,"speakerActor":"tails","speakerName":"","text":"Hold here.","skinId":"","typerId":"pace","x":184,"y":8,"width":128,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"regroup.dialogue2","startFrame":1695,"endFrame":1790,"speakerActor":"knuckles","speakerName":"","text":"Glide, release, land. Easy.","skinId":"","typerId":"pace","x":8,"y":8,"width":304,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"regroup.dialogue3","startFrame":1970,"endFrame":2070,"speakerActor":"tails","speakerName":"","text":"One more pass.","skinId":"","typerId":"pace","x":184,"y":8,"width":128,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"regroup.dialogue4","startFrame":2110,"endFrame":2205,"speakerActor":"knuckles","speakerName":"","text":"Back to the platform marks.","skinId":"","typerId":"pace","x":8,"y":8,"width":304,"height":48,"portraitAsset":"","revealFrames":[]},{"id":"retry.dialogue0","startFrame":2240,"endFrame":2325,"speakerActor":"sonic","speakerName":"","text":"Same marks. New t