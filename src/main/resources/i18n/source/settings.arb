  },
  "settings.key.capture_queue_budget_mb.label": "Queue budget MB",
  "@settings.key.capture_queue_budget_mb.label": {
    "description": "Settings label for stable configuration key CAPTURE_QUEUE_BUDGET_MB (capture.queueBudgetMb)."
  },
  "settings.key.capture_queue_budget_mb.help": "Memory budget in MB for the live-recording encoder queue. The queue is sized in whole frames from this budget and the recording viewport, so it holds fewer frames at larger window sizes. A deeper queue absorbs longer encoder stalls -- lossless FFV1 falls behind on high-motion content such as fast-forwarded trace playback -- before backpressure stalls the game loop",
  "@settings.key.capture_queue_budget_mb.help": {
    "description": "Settings help for stable configuration key CAPTURE_QUEUE_BUDGET_MB. Technical YAML documentation remains separate."
  },
  "settings.key.capture_encoder_threads.label": "Encoder threads",
  "@settings.key.capture_encoder_threads.label": {
    "description": "Settings label for stable configuration key CAPTURE_ENCODER_THREADS (capture.encoderThreads)."
  },
  "settings.key.capture_encoder_threads.help": "ffmpeg thread count for the encode pass. 0 lets ffmpeg choose, normally one thread per core. FFV1 is additionally sliced so threads can be used at all; x264/x265 already thread internally, so raising this rarely helps them -- use encoderPreset instead",
  "@settings.key.capture_encoder_threads.help": {
    "description": "Settings help for stable configuration key CAPTURE_ENCODER_THREADS. Technical YAML documentation remains separate."
  },
  "settings.key.capture_encoder_preset.label": "Encoder preset",
  "@settings.key.capture_encoder_preset.label": {
    "description": "Settings label for stable configuration key CAPTURE_ENCODER_PRESET (capture.encoderPreset)."
  },
  "settings.key.capture_encoder_preset.help": "x264/x265 speed preset: ultrafast, superfast, veryfast, faster, fast, medium, slow, slower, veryslow or placebo. Blank uses the encoder's own default (medium). Ignored by FFV1, which has no preset. Presets trade encode speed for file size and never affect losslessness. Defaults to fast: libx265 at medium keeps up with ordinary play but not with high-motion content such as fast-forwarded trace playback, where each recorded frame is several gameplay frames from the last",
  "@settings.key.capture_encoder_preset.help": {
    "description": "Settings help for stable configuration key CAPTURE_ENCODER_PRESET. Technical YAML documentation remains separate."
  },
  "settings.key.capture_container.label": "Container",
  "@settings.key.capture_container.label": {
    "description": "Settings label for stable configuration key CAPTURE_CONTAINER (capture.container)."
  },
  "settings.key.capture_container.help": "Recording file extension, e.g. mkv or mp4. ffmpeg picks its muxer from this. Recent ffmpeg will write every codec here into either container, but player support is much narrower: mkv plays everything, while mp4 is portable only with h264/h265 + aac. mp4 holding ffv1 or flac is a valid file most players will refuse",
  "@settings.key.capture_container.help": {
    "description": "Settings help for stable configuration key CAPTURE_CONTAINER. Technical YAML documentation remains separate."
  },
  "settings.key.capture_ffmpeg_pass1_args.label": "Encoder command arguments",
