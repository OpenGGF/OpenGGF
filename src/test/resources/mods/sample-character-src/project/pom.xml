<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
  <modelVersion>4.0.0</modelVersion><groupId>example</groupId><artifactId>phase3-character</artifactId><version>1.0.0</version>
  <properties><maven.compiler.release>21</maven.compiler.release></properties>
  <dependencies>
    <dependency><groupId>com.openggf</groupId><artifactId>OpenGGF-local</artifactId><version>0</version><scope>system</scope><systemPath>${openggf.engine.jar}</systemPath></dependency>
    <dependency><groupId>com.openggf</groupId><artifactId>OpenGGF-sdk-local</artifactId><version>0</version><scope>system</scope><systemPath>${openggf.sdk.jar}</systemPath></dependency>
    <dependency><groupId>com.fasterxml.jackson.dataformat</groupId><artifactId>jackson-dataformat-yaml</artifactId><version>2.22.0</version></dependency>
    <dependency><groupId>org.ow2.asm</groupId><artifactId>asm</artifactId><version>9.9.1</version></dependency>
  </dependencies>
  <build><finalName>phase3-character-mod</finalName><plugins>
    <plugin><groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId><version>3.1.0</version><executions>
      <execution><id>convert-playable-art</id><phase>generate-resources</phase><goals><goal>exec</goal></goals><configuration>
        <executable>java</executable><classpathScope>compile</classpathScope><arguments><argument>-cp</argument><classpath/><argument>com.openggf.tools.modsdk.GgfModCli</argument>
          <argument>convert</argument><argument>art</argument><argument>--playable</argument><argument>--image</argument><argument>${project.basedir}/src/main/mod/runner.png</argument><argument>--sheet</argument><argument>${project.basedir}/src/main/mod/runner-sheet.yaml</argument><argument>--out</argument><argument>${project.build.outputDirectory}/art/runner.ggfp</argument>
        </arguments></configuration></execution>
      <execution><id>package-mod</id><phase>prepare-package</phase><goals><goal>exec</goal></goals><configuration>
        <executable>java</executable><classpathScope>compile</classpathScope><arguments><argument>-cp</argument><classpath/><argument>com.openggf.tools.modsdk.GgfModCli</argument><argument>package</argument><argument>--input</argument><argument>${project.build.outputDirectory}</argument><argument>--out</argument><argument>${project.build.directory}/phase3-character-mod.jar</argument></arguments>
      </configuration></execution>
    </executions></plugin>
  </plugins></build>
</project>
