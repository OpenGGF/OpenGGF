+static const struct gpgx_audio_service_hook_v1 *deferred_reserve_for_origin(
+  uint8_t origin)
+{
+  uint32_t i;
+  for (i = 0; i < trace_config.hook_count; i++)
+    if (trace_hooks[i].action == ACTION_RESERVE_DEFERRED_BEGIN
+        && trace_hooks[i].expected_active_kind == origin)
+      return &trace_hooks[i];
+  return NULL;
+}
+
+static uint32_t matching_observation_count(
+  const struct gpgx_audio_service_hook_v1 *source, uint8_t expected)
+{
+  uint32_t i, count = 0;
+  for (i = 0; i < trace_config.hook_count; i++)
+    if (trace_hooks[i].action == ACTION_OBSERVATION_MARKER
+        && trace_hooks[i].expected_active_kind == expected
+        && same_hook_site(source, &trace_hooks[i])) count++;
+  return count;
+}
+
+static int is_closed_origin_observation(
+  const struct gpgx_audio_service_hook_v1 *hook)
+{
+  const struct gpgx_audio_service_hook_v1 *reserve =
+    deferred_reserve_for_origin(hook->expected_active_kind);
+  return reserve && hook->action == ACTION_OBSERVATION_MARKER
+    && (is_deferred_pair_hook(hook)
+      || matching_observation_count(hook, reserve->service_kind) == 1u);
+}
+
+static int exact_closed_origin_topology(
+  const struct gpgx_audio_service_hook_v1 *hook)
+{
+  const struct gpgx_audio_service_hook_v1 *reserve =
+    deferred_reserve_for_origin(hook->expected_active_kind);
+  const struct trace_stack_entry *parent, *origin;
+  if (!reserve) return 1;
+  if (trace_deferred_begin.pending || trace_depth != 2u) return 0;
+  parent = &trace_stack[0]; origin = &trace_stack[1];
+  return parent->token && !parent->parent && parent->kind == reserve->service_kind
+    && parent->depth == 0u && origin->token
+    && origin->parent == parent->token
+    && origin->kind == hook->expected_active_kind && origin->depth == 1u;
+}
