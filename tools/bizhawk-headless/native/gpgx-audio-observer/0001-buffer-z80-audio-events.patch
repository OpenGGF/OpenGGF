+#define GPGX_AUDIO_TRACE_ENTER(cpu, previous) do { \
+  (previous) = 0; \
+  if (__builtin_expect(gpgx_audio_trace_enabled != 0, 0)) \
+    (previous) = gpgx_audio_trace_enter_cpu(cpu); \
+} while (0)
+
+#define GPGX_AUDIO_TRACE_LEAVE(previous) do { \
+  if (__builtin_expect(gpgx_audio_trace_enabled != 0, 0)) \
+    gpgx_audio_trace_leave_cpu(previous); \
+} while (0)
+
+#define GPGX_AUDIO_TRACE_INSTRUCTION_ENABLED(cpu, pc) do { \
+  uint32_t trace_pc_ = (uint32_t)(pc); \
+  if ((cpu) == GPGX_AUDIO_TRACE_CPU_Z80) trace_z80_instruction_pc = trace_pc_; \
+  else trace_m68k_instruction_pc = trace_pc_; \
+  uint8_t *trace_watch_ = (cpu) == GPGX_AUDIO_TRACE_CPU_Z80 \
+    ? gpgx_audio_trace_z80_watch_mask : gpgx_audio_trace_m68k_watch_mask; \
+  if (__builtin_expect((trace_watch_[(trace_pc_ & 0xffffu) >> 3] \
+      & (1u << (trace_pc_ & 7))) != 0, 0)) \
+    gpgx_audio_trace_instruction((cpu), trace_pc_); \
+} while (0)
+
+#define GPGX_AUDIO_TRACE_INSTRUCTION(cpu, pc) do { \
+  if (__builtin_expect(gpgx_audio_trace_enabled != 0, 0)) \
+    GPGX_AUDIO_TRACE_INSTRUCTION_ENABLED((cpu), (pc)); \
+} while (0)
+
+#endif
