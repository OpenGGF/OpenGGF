+#ifndef GPGX_AUDIO_TRACE_H
+#define GPGX_AUDIO_TRACE_H
+
+#include <stdint.h>
+
+#define GPGX_AUDIO_TRACE_ABI_VERSION 3u
+#define GPGX_AUDIO_TRACE_EVENT_CAPACITY 65536u
+#define GPGX_AUDIO_TRACE_EVENT_SIZE 32u
+
+#define GPGX_AUDIO_TRACE_CPU_Z80 1u
+#define GPGX_AUDIO_TRACE_CPU_M68K 2u
+#define GPGX_AUDIO_TRACE_CPU_RESET 3u
+
+#define GPGX_AUDIO_TRACE_FAULT_NONE 0u
+#define GPGX_AUDIO_TRACE_FAULT_TOKEN 1u
+#define GPGX_AUDIO_TRACE_FAULT_SNAPSHOT 2u
+#define GPGX_AUDIO_TRACE_FAULT_STACK 3u
+#define GPGX_AUDIO_TRACE_FAULT_SERVICE 4u
+#define GPGX_AUDIO_TRACE_FAULT_HOOK_PROOF 5u
+#define GPGX_AUDIO_TRACE_FAULT_ARM_PROOF 6u
+#define GPGX_AUDIO_TRACE_FAULT_CHIP_OWNERSHIP 7u
+#define GPGX_AUDIO_TRACE_FAULT_CAPACITY 8u
+#define GPGX_AUDIO_TRACE_FAULT_CONTINUATION 9u
+
+struct __attribute__((packed)) gpgx_audio_trace_config_v1
+{
+  uint32_t magic;
+  uint16_t abi_version;
+  uint16_t struct_size;
+  uint16_t hook_size;
+  uint16_t range_size;
+  uint16_t event_size;
+  uint8_t max_depth;
+  uint8_t max_opcode_bytes;
+  uint16_t reset_service_kind;
