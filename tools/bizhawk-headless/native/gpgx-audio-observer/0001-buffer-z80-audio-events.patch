+static int is_snapshot_range(const struct gpgx_audio_snapshot_range_v1 *range)
+{
+  return range->flags == RANGE_Z80_RAM || range->flags == RANGE_M68K_RAM;
+}
+
+static int validate_slice(uint16_t first, uint16_t count, uint32_t *bytes)
+{
+  uint32_t i, j, sum = 0;
+  if (!count || first >= trace_config.range_count || count > trace_config.range_count - first) return 0;
+  for (i = 0; i < count; i++)
+  {
+    const struct gpgx_audio_snapshot_range_v1 *a = &trace_ranges[first + i];
+    uint32_t a_end = (uint32_t)a->start + a->length;
+    uint32_t limit;
+    if (!is_snapshot_range(a) || !a->length) return 0;
+    limit = a->flags == RANGE_M68K_RAM ? 0x10000u : 0x2000u;
+    if (a_end > limit) return 0;
+    if (sum > TRACE_MAX_SNAPSHOT_BYTES - a->length) return 0;
+    sum += a->length;
+    for (j = 0; j < i; j++)
+    {
+      const struct gpgx_audio_snapshot_range_v1 *b = &trace_ranges[first + j];
+      uint32_t b_end = (uint32_t)b->start + b->length;
+      if (a->flags == b->flags
+          && (uint32_t)a->start < b_end && (uint32_t)b->start < a_end) return 0;
+    }
+  }
+  *bytes = sum;
+  return 1;
+}
