+  for (i = 0; i < count; i++)
+  {
+    const struct gpgx_audio_snapshot_range_v1 *range = &trace_ranges[first + i];
+    if (range->flags != RANGE_M68K_RETURN_PC || range->start || range->length
+        || !range->reserved[0] || (range->reserved[0] & 1u)
+        || range->reserved[0] > 0xffffffu || range->reserved[1]) return 0;
+  }
+  return 1;
+}
