+static void fail_runtime_at(uint32_t reason, uint8_t source_cpu, uint32_t pc)
+{
+  const struct trace_stack_entry *active = trace_depth ? &trace_stack[trace_depth - 1] : NULL;
+  const struct gpgx_audio_service_kind_v1 *kind = active ? kind_for(active->kind) : NULL;
+  trace_runtime_error = 1;
+  if (trace_first_fault.reason) return;
+  trace_first_fault.reason = reason;
+  trace_first_fault.source_cpu = source_cpu;
+  trace_first_fault.pc = pc;
+  trace_first_fault.active_kind = active ? active->kind : 0;
+  trace_first_fault.active_depth = trace_depth;
+  trace_first_fault.continuation_count = active ? active->carried_frames : 0;
+  trace_first_fault.continuation_limit = kind ? kind->continuation_frame_limit : 0;
+}
