+static int same_stack_entry(const struct trace_stack_entry *a,
+  const struct trace_stack_entry *b)
+{
+  return a->token == b->token && a->parent == b->parent
+    && a->kind == b->kind && a->depth == b->depth;
+}
+
+static int same_hook_site(const struct gpgx_audio_service_hook_v1 *a,
+  const struct gpgx_audio_service_hook_v1 *b)
+{
+  return a->cpu == b->cpu && a->pc == b->pc
+    && a->opcode_length == b->opcode_length
+    && !memcmp(a->opcode, b->opcode, a->opcode_length);
