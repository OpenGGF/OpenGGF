+  uint32_t max_service_tokens_per_frame;
+  uint16_t kind_size;
+  uint16_t kind_count;
+  uint32_t reserved[3];
+};
+
+struct __attribute__((packed)) gpgx_audio_service_kind_v1
+{
+  uint8_t kind_id;
+  uint8_t flags;
+  uint16_t cancellation_range_first;
+  uint16_t cancellation_range_count;
+  uint8_t continuation_frame_limit;
+  uint8_t reserved0;
+  uint32_t reserved[2];
+};
+
+struct __attribute__((packed)) gpgx_audio_service_hook_v1
+{
+  uint16_t hook_token;
+  uint8_t action;
+  uint8_t cpu;
+  uint32_t pc;
+  uint8_t service_kind;
+  uint8_t expected_active_kind;
+  uint8_t flags;
+  uint8_t opcode_length;
+  uint16_t range_first;
+  uint16_t range_count;
+  uint8_t opcode[8];
+  uint8_t reserved[8];
+};
+
+struct __attribute__((packed)) gpgx_audio_snapshot_range_v1
+{
+  uint16_t range_id;
+  uint16_t start;
+  uint16_t length;
+  uint16_t flags;
+  uint32_t reserved[2];
+};
+
+struct __attribute__((packed)) gpgx_audio_trace_event
+{
+  uint32_t ordinal;
+  uint16_t service_token;
+  uint16_t parent_token;
+  uint32_t pc;
+  uint16_t subject;
+  uint16_t offset;
+  uint8_t kind;
+  uint8_t service_kind;
+  uint8_t depth;
+  uint8_t source_cpu;
+  uint8_t payload_length;
+  uint8_t value;
+  uint8_t flags;
+  uint8_t reserved;
+  uint8_t payload[8];
+};
+
+struct __attribute__((packed)) gpgx_audio_trace_first_fault_v1
+{
+  uint32_t reason;
+  uint32_t pc;
+  uint8_t source_cpu;
+  uint8_t active_kind;
+  uint8_t active_depth;
+  uint8_t continuation_count;
+  uint8_t continuation_limit;
+  uint8_t reserved[3];
+};
+
+extern volatile uint8_t gpgx_audio_trace_enabled;
+extern uint8_t gpgx_audio_trace_z80_watch_mask[8192];
+extern uint8_t gpgx_audio_trace_m68k_watch_mask[8192];
+extern uint32_t trace_z80_instruction_pc;
+extern uint32_t trace_m68k_instruction_pc;
+
+uint8_t gpgx_audio_trace_enter_cpu(uint8_t cpu);
+void gpgx_audio_trace_leave_cpu(uint8_t previous);
+void gpgx_audio_trace_instruction(uint8_t cpu, uint32_t pc);
+void gpgx_audio_trace_fm_write(uint32_t address, uint32_t data);
+void gpgx_audio_trace_psg_write(uint32_t data);
+void gpgx_audio_trace_reset_begin(uint8_t hard);
+void gpgx_audio_trace_reset_end(uint8_t hard);
+uint32_t gpgx_audio_trace_abi_version(void);
+uint32_t gpgx_audio_trace_event_size(void);
+uint32_t gpgx_audio_trace_capacity(void);
+int32_t gpgx_audio_trace_configure(
+  const struct gpgx_audio_trace_config_v1 *config, const uint8_t *mask,
+  const struct gpgx_audio_service_kind_v1 *kinds,
+  const struct gpgx_audio_service_hook_v1 *hooks,
+  const struct gpgx_audio_snapshot_range_v1 *ranges);
+int32_t gpgx_audio_trace_begin_publication_epoch(void);
+int32_t gpgx_audio_trace_first_fault(struct gpgx_audio_trace_first_fault_v1 *out);
+int32_t gpgx_audio_trace_begin_frame(void);
+int32_t gpgx_audio_trace_end_frame(void);
+int32_t gpgx_audio_trace_event_count(uint32_t *required_count, uint32_t *overflow_count);
+int32_t gpgx_audio_trace_drain(struct gpgx_audio_trace_event *out,
+  uint32_t out_capacity, uint32_t *out_count);
+int32_t gpgx_audio_trace_abort_frame(void);
+int32_t gpgx_audio_trace_disable(void);
