+static uint32_t range_group_reservation(uint16_t first, uint16_t count, int reset_end)
+{
+  uint32_t total = reset_end ? 1u : 1u;
+  uint32_t i;
+  for (i = 0; i < count; i++)
+  {
+    uint32_t length = trace_ranges[first + i].length;
+    total += 2u + ((length + 7u) / 8u);
+  }
+  return total;
