+static void fail_runtime(uint32_t reason)
+{
+  uint32_t pc = trace_issue_source == GPGX_AUDIO_TRACE_CPU_Z80
+    ? trace_z80_instruction_pc : trace_issue_source == GPGX_AUDIO_TRACE_CPU_M68K
+      ? trace_m68k_instruction_pc : 0;
+  fail_runtime_at(reason, trace_issue_source, pc);
