+static const struct gpgx_audio_service_hook_v1 *deferred_consume_for_kind(uint8_t kind)
+{
+  uint32_t i;
+  for (i = 0; i < trace_config.hook_count; i++)
+    if (trace_hooks[i].action == ACTION_CONSUME_DEFERRED_BEGIN
+        && trace_hooks[i].expected_active_kind == kind)
+      return &trace_hooks[i];
+  return NULL;
