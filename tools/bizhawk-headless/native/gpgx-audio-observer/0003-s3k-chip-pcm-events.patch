+ECL_EXPORT int32_t gpgx_s3k_pcm_configure(
+  const struct gpgx_s3k_pcm_config_v1 *config)
+{
+  if (s3k_pcm_phase != PHASE_DISABLED) return TRACE_INVALID_PHASE;
+  if (!config || config->magic != S3K_PCM_MAGIC
+      || config->abi_version != GPGX_S3K_PCM_ABI_VERSION
+      || config->struct_size != sizeof(*config)
+      || config->event_size != sizeof(struct gpgx_s3k_pcm_event_v1)
+      || config->event_capacity != GPGX_S3K_PCM_EVENT_CAPACITY
+      || config->reserved0
+      || !bytes_are_zero((const uint8_t *)config->reserved,
+        sizeof(config->reserved))) return TRACE_INVALID_ARGUMENT;
+  s3k_pcm_event_count_value = s3k_pcm_omitted_count = 0;
+  s3k_pcm_ym_ordinal = s3k_pcm_psg_ordinal = 0;
+  s3k_pcm_phase = PHASE_CONFIGURED;
+  gpgx_s3k_pcm_enabled = 1;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_s3k_pcm_begin_frame(void)
+{
+  if (s3k_pcm_phase != PHASE_CONFIGURED) return TRACE_INVALID_PHASE;
+  s3k_pcm_event_count_value = s3k_pcm_omitted_count = 0;
+  s3k_pcm_phase = PHASE_RECORDING;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_s3k_pcm_end_frame(void)
+{
+  if (s3k_pcm_phase != PHASE_RECORDING) return TRACE_INVALID_PHASE;
+  s3k_pcm_phase = PHASE_READY;
+  return s3k_pcm_omitted_count ? TRACE_OVERFLOW : TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_s3k_pcm_event_count(
+  uint32_t *required_count, uint32_t *overflow_count)
+{
+  if (s3k_pcm_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  if (!required_count || !overflow_count) return TRACE_INVALID_ARGUMENT;
+  *required_count = s3k_pcm_event_count_value;
+  *overflow_count = s3k_pcm_omitted_count;
+  return s3k_pcm_omitted_count ? TRACE_OVERFLOW : TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_s3k_pcm_drain(struct gpgx_s3k_pcm_event_v1 *out,
+  uint32_t out_capacity, uint32_t *out_count)
+{
+  if (s3k_pcm_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  if (!out_count) return TRACE_INVALID_ARGUMENT;
+  *out_count = s3k_pcm_event_count_value;
+  if (s3k_pcm_omitted_count) return TRACE_OVERFLOW;
+  if (s3k_pcm_event_count_value && (!out
+      || out_capacity < s3k_pcm_event_count_value))
+    return out ? TRACE_OUTPUT_CAPACITY : TRACE_INVALID_ARGUMENT;
+  if (!s3k_pcm_event_count_value && (out || out_capacity))
+    return TRACE_INVALID_ARGUMENT;
+  if (s3k_pcm_event_count_value)
+    memcpy(out, s3k_pcm_events,
+      s3k_pcm_event_count_value * sizeof(s3k_pcm_events[0]));
+  s3k_pcm_event_count_value = 0;
+  s3k_pcm_phase = PHASE_CONFIGURED;
+  return TRACE_OK;
+}
