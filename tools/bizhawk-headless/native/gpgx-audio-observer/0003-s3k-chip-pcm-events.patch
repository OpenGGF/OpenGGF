+  s3k_pcm_ym_ordinal = s3k_pcm_psg_ordinal = 0;
+  s3k_pcm_phase = PHASE_DISABLED;
+  gpgx_s3k_pcm_enabled = 0;
+  return TRACE_OK;
+}
