+static void psg_trace_native_samples(unsigned int clocks)
+{
+  int counter[4], polarity[4], shift_value, sample_time, i;
+  memcpy(counter, psg.freqCounter, sizeof(counter));
+  memcpy(polarity, psg.polarity, sizeof(polarity));
+  shift_value = psg.noiseShiftValue;
+  sample_time = ((psg.clocks + PSG_MCYCLES_RATIO - 1)
+    / PSG_MCYCLES_RATIO) * PSG_MCYCLES_RATIO;
+  while ((unsigned int)sample_time < clocks)
+  {
+    int left = 0, right = 0;
+    for (i=0; i<3; i++)
+    {
+      while (counter[i] <= sample_time)
+      {
+        polarity[i] = -polarity[i];
+        counter[i] += psg.freqInc[i];
+      }
+      if (polarity[i] > 0)
+      {
+        left += psg.chanOut[i][0];
+        right += psg.chanOut[i][1];
+      }
+    }
+    while (counter[3] <= sample_time)
+    {
+      polarity[3] = -polarity[3];
+      if (polarity[3] > 0)
+      {
+        int output = shift_value & 1;
+        if (psg.regs[6] & 4)
+          shift_value = (shift_value >> 1)
+            | (noiseFeedback[shift_value & psg.noiseBitMask]
+              << psg.noiseShiftWidth);
+        else
+          shift_value = (shift_value >> 1)
+            | (output << psg.noiseShiftWidth);
+      }
+      counter[3] += psg.freqInc[3];
+    }
+    if (shift_value & 1)
+    {
+      left += psg.chanOut[3][0];
+      right += psg.chanOut[3][1];
+    }
+    gpgx_s3k_pcm_psg_sample(left, right);
+    sample_time += PSG_MCYCLES_RATIO;
+  }
+}
