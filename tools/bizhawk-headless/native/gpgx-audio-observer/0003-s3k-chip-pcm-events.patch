+static void s3k_pcm_emit(uint8_t tap, uint32_t ordinal,
+  uint64_t master_cycle, int32_t left, int32_t right)
+{
+  struct gpgx_s3k_pcm_event_v1 *event;
+  if (s3k_pcm_phase != PHASE_RECORDING) return;
+  if (s3k_pcm_event_count_value >= GPGX_S3K_PCM_EVENT_CAPACITY)
+  {
+    if (s3k_pcm_omitted_count != UINT32_MAX) s3k_pcm_omitted_count++;
+    return;
+  }
+  event = &s3k_pcm_events[s3k_pcm_event_count_value];
+  memset(event, 0, sizeof(*event));
+  event->event_ordinal = s3k_pcm_event_count_value++;
+  event->sample_ordinal = ordinal;
+  event->master_cycle = master_cycle;
+  event->left = left;
