+static void s3k_parity_fail(uint32_t reason, uint32_t pc)
+{
+  s3k_parity_runtime_error = 1;
+  if (s3k_parity_fault.reason) return;
+  s3k_parity_fault.reason = reason;
+  s3k_parity_fault.pc = pc;
+  s3k_parity_fault.transaction_id = s3k_parity_active.transaction_id;
+  s3k_parity_fault.track_base = s3k_parity_active.track_base;
+  s3k_parity_fault.service_kind = trace_depth ? trace_stack[trace_depth - 1].kind : 0;
+}
+
+static uint32_t s3k_parity_track_count(void)
+{
+  return ((uint32_t)s3k_parity_config.song_track_end
+      - s3k_parity_config.song_track_first
+      + (uint32_t)s3k_parity_config.sfx_track_end
+      - s3k_parity_config.sfx_track_first) / s3k_parity_config.track_size;
+}
+
+static int s3k_parity_track_slot(uint16_t ix, uint16_t *slot, uint8_t *type)
+{
+  uint32_t song_count = ((uint32_t)s3k_parity_config.song_track_end
+      - s3k_parity_config.song_track_first) / s3k_parity_config.track_size;
+  if (ix >= s3k_parity_config.song_track_first
+      && ix < s3k_parity_config.song_track_end
+      && ((ix - s3k_parity_config.song_track_first) % s3k_parity_config.track_size) == 0)
+  {
+    *slot = (uint16_t)((ix - s3k_parity_config.song_track_first)
+      / s3k_parity_config.track_size);
+    *type = 1u;
+    return 1;
+  }
+  if (ix >= s3k_parity_config.sfx_track_first
+      && ix < s3k_parity_config.sfx_track_end
+      && ((ix - s3k_parity_config.sfx_track_first) % s3k_parity_config.track_size) == 0)
+  {
+    *slot = (uint16_t)(song_count + (ix - s3k_parity_config.sfx_track_first)
+      / s3k_parity_config.track_size);
+    *type = 2u;
+    return 1;
+  }
+  return 0;
+}
+
+static void s3k_parity_scan_generations(const uint8_t *ram)
+{
+  uint32_t i, count = s3k_parity_track_count();
+  for (i = 0; i < count; i++)
+  {
+    uint16_t address;
+    uint32_t song_count = ((uint32_t)s3k_parity_config.song_track_end
+      - s3k_parity_config.song_track_first) / s3k_parity_config.track_size;
+    uint8_t playing;
+    if (i < song_count)
+      address = (uint16_t)(s3k_parity_config.song_track_first
+        + i * s3k_parity_config.track_size);
+    else
+      address = (uint16_t)(s3k_parity_config.sfx_track_first
+        + (i - song_count) * s3k_parity_config.track_size);
+    playing = (uint8_t)((ram[address] >> 7) & 1u);
+    if (playing && !s3k_parity_track_playing[i])
+    {
+      if (s3k_parity_track_generation[i] == UINT16_MAX)
+      { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_CONFIG, 0); return; }
+      s3k_parity_track_generation[i]++;
+    }
+    s3k_parity_track_playing[i] = playing;
+  }
+}
+
+static struct gpgx_s3k_audio_parity_event_v1 *s3k_parity_new_event(void)
+{
+  struct gpgx_s3k_audio_parity_event_v1 *event;
+  if (s3k_parity_event_count_value >= GPGX_S3K_AUDIO_PARITY_EVENT_CAPACITY)
+  {
+    if (s3k_parity_omitted_count != UINT32_MAX) s3k_parity_omitted_count++;
+    s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_CAPACITY,
+      trace_z80_instruction_pc);
+    return NULL;
+  }
+  event = &s3k_parity_events[s3k_parity_event_count_value];
+  memset(event, 0, sizeof(*event));
+  event->event_ordinal = s3k_parity_event_count_value++;
+  return event;
+}
+
+static void s3k_parity_emit(uint32_t master_cycle, uint8_t chip,
+  uint8_t port, uint8_t reg, uint8_t value)
+{
+  struct gpgx_s3k_audio_parity_event_v1 *event;
+  if (!s3k_parity_active.active || s3k_parity_runtime_error) return;
+  event = s3k_parity_new_event();
+  if (!event) return;
+  event->master_cycle = master_cycle;
+  event->vint_ordinal = s3k_parity_vint_ordinal;
+  event->service_entry_master_cycle = s3k_parity_active.service_entry_master_cycle;
+  event->transaction_id = s3k_parity_active.transaction_id;
+  event->service_ordinal = s3k_parity_active.service_ordinal;
+  event->generation = s3k_parity_active.generation;
+  event->track_base = s3k_parity_active.track_base;
+  event->source_pointer = s3k_parity_active.source_pointer;
+  event->source_pc = (uint16_t)trace_z80_instruction_pc;
+  event->service_kind = s3k_parity_active.service_kind;
+  event->track_type = s3k_parity_active.track_type;
+  event->channel_id = s3k_parity_active.channel_id;
+  event->bank = s3k_parity_active.bank;
+  event->chip = chip;
+  event->port = port;
+  event->register_id = reg;
+  event->value = value;
+}
+
+void gpgx_s3k_audio_parity_instruction(uint32_t pc, uint32_t master_cycle,
+  uint32_t owner_ix, uint32_t opcode, const uint8_t *ram)
+{
+  uint32_t i, matches = 0;
+  uint16_t slot = 0;
+  uint8_t track_type = 0;
+  const struct gpgx_s3k_audio_parity_descriptor_v1 *selected = NULL;
+  uint16_t ix = (uint16_t)owner_ix;
+  uint8_t active_kind;
+  if (s3k_parity_phase != PHASE_RECORDING || s3k_parity_runtime_error) return;
+  trace_z80_instruction_pc = pc;
+  if (!ram) { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_CONFIG, pc); return; }
+  s3k_parity_scan_generations(ram);
+  if (s3k_parity_runtime_error) return;
+  active_kind = trace_depth ? trace_stack[trace_depth - 1].kind : 0;
+  if (trace_depth && trace_stack[trace_depth - 1].token != s3k_parity_last_service_token)
+  {
+    s3k_parity_last_service_token = trace_stack[trace_depth - 1].token;
+    s3k_parity_service_entry_master_cycle = master_cycle;
+  }
+  if (s3k_parity_active.active)
+  {
+    const struct gpgx_s3k_audio_parity_descriptor_v1 *descriptor = NULL;
+    for (i = 0; i < s3k_parity_config.descriptor_count; i++)
+      if (s3k_parity_descriptors[i].descriptor_id
+          == s3k_parity_active.descriptor_id) descriptor = &s3k_parity_descriptors[i];
+    if (!descriptor)
+    { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_CONFIG, pc); return; }
+    if (active_kind != s3k_parity_active.service_kind)
+    { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_SERVICE, pc); return; }
+    if ((uint16_t)pc == descriptor->end_pc
+        && (uint8_t)opcode == descriptor->end_opcode)
+    {
+      if (ix != s3k_parity_active.track_base)
+      { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_OWNER_MUTATION, pc); return; }
+      memset(&s3k_parity_active, 0, sizeof(s3k_parity_active)); return;
+    }
+  }
+  for (i = 0; i < s3k_parity_config.descriptor_count; i++)
+  {
+    const struct gpgx_s3k_audio_parity_descriptor_v1 *candidate =
+      &s3k_parity_descriptors[i];
+    if ((uint16_t)pc == candidate->begin_pc
+        && (uint8_t)opcode == candidate->begin_opcode)
+    { selected = candidate; matches++; }
+  }
+  if (!matches) return;
+  if (matches != 1 || s3k_parity_active.active)
+  { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_NESTED, pc); return; }
+  if (!trace_depth || active_kind != selected->expected_service_kind)
+  { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_SERVICE, pc); return; }
+  if (!s3k_parity_track_slot(ix, &slot, &track_type)
+      || track_type != selected->expected_track_type)
+  { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_OWNER_MUTATION, pc); return; }
+  if (!(ram[ix] & 0x80u) || !s3k_parity_track_generation[slot])
+  { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_OWNER_MUTATION, pc); return; }
+  memset(&s3k_parity_active, 0, sizeof(s3k_parity_active));
+  if (!++s3k_parity_next_transaction_id)
+  { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_CONFIG, pc); return; }
+  s3k_parity_active.transaction_id = s3k_parity_next_transaction_id;
+  s3k_parity_active.service_entry_master_cycle = s3k_parity_service_entry_master_cycle;
+  s3k_parity_active.descriptor_id = selected->descriptor_id;
+  s3k_parity_active.service_ordinal = trace_stack[trace_depth - 1].token;
+  s3k_parity_active.generation = s3k_parity_track_generation[slot];
+  s3k_parity_active.track_base = ix;
+  s3k_parity_active.source_pointer = (uint16_t)(ram[ix + 3u]
+    | ((uint16_t)ram[ix + 4u] << 8));
+  s3k_parity_active.service_kind = active_kind;
+  s3k_parity_active.track_type = track_type;
+  s3k_parity_active.channel_id = ram[ix + 1u];
+  s3k_parity_active.bank = track_type == 2u ? s3k_parity_config.fixed_sfx_bank
+    : ram[s3k_parity_config.song_bank_address];
+  s3k_parity_active.active = 1;
+}
+
+void gpgx_s3k_audio_parity_fm_write(uint32_t master_cycle,
+  uint32_t address, uint32_t data)
+{
+  if (s3k_parity_phase == PHASE_DISABLED) return;
+  if (!(address & 1u))
+  {
+    s3k_parity_fm_address = (uint16_t)data
+      | (uint16_t)((address & 2u) << 7);
+    s3k_parity_fm_address_valid = 1;
+    return;
+  }
+  if (s3k_parity_phase != PHASE_RECORDING) return;
+  if (s3k_parity_active.active && !s3k_parity_fm_address_valid)
+  { s3k_parity_fail(GPGX_S3K_AUDIO_PARITY_FAULT_INTERRUPTED,
+      trace_z80_instruction_pc); return; }
+  if (s3k_parity_fm_address_valid)
+    s3k_parity_emit(master_cycle, GPGX_S3K_AUDIO_PARITY_CHIP_YM2612,
+      (uint8_t)(s3k_parity_fm_address >> 8),
+      (uint8_t)s3k_parity_fm_address, (uint8_t)data);
+}
+
+void gpgx_s3k_audio_parity_psg_write(uint32_t master_cycle, uint32_t data)
+{
+  if (s3k_parity_phase == PHASE_RECORDING)
+    s3k_parity_emit(master_cycle, GPGX_S3K_AUDIO_PARITY_CHIP_PSG,
+      0, 0, (uint8_t)data);
+}
