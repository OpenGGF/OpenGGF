+ECL_EXPORT int32_t gpgx_s3k_audio_parity_end_frame(void)
+{
+  if (s3k_parity_phase != PHASE_RECORDING) return TRACE_INVALID_PHASE;
+  s3k_parity_phase = PHASE_READY;
+  if (s3k_parity_omitted_count) return TRACE_OVERFLOW;
+  return s3k_parity_runtime_error ? TRACE_ABI_OR_CONFIG_LIMIT : TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_s3k_audio_parity_event_count(
+  uint32_t *required_count, uint32_t *overflow_count)
+{
+  if (s3k_parity_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  if (!required_count || !overflow_count) return TRACE_INVALID_ARGUMENT;
+  *required_count = s3k_parity_event_count_value;
+  *overflow_count = s3k_parity_omitted_count;
+  return s3k_parity_omitted_count ? TRACE_OVERFLOW : TRACE_OK;
