+ECL_EXPORT int32_t gpgx_s3k_audio_parity_configure(
+  const struct gpgx_s3k_audio_parity_config_v1 *config,
+  const struct gpgx_s3k_audio_parity_descriptor_v1 *descriptors)
+{
+  uint32_t i, j, count;
+  if (s3k_parity_phase != PHASE_DISABLED) return TRACE_INVALID_PHASE;
+  if (!config || !descriptors
+      || config->magic != S3K_PARITY_MAGIC
+      || config->abi_version != GPGX_S3K_AUDIO_PARITY_ABI_VERSION
+      || config->struct_size != sizeof(*config)
+      || config->descriptor_size != sizeof(descriptors[0])
+      || config->event_size != sizeof(struct gpgx_s3k_audio_parity_event_v1)
+      || !config->descriptor_count
+      || config->descriptor_count > GPGX_S3K_AUDIO_PARITY_MAX_DESCRIPTORS
+      || config->event_capacity != GPGX_S3K_AUDIO_PARITY_EVENT_CAPACITY
+      || !config->track_size
+      || config->song_track_first >= config->song_track_end
+      || config->sfx_track_first >= config->sfx_track_end
+      || ((config->song_track_end - config->song_track_first) % config->track_size)
+      || ((config->sfx_track_end - config->sfx_track_first) % config->track_size)
+      || config->song_bank_address >= 0x2000u
+      || config->reserved0 || config->reserved1
+      || !bytes_are_zero((const uint8_t *)config->reserved, sizeof(config->reserved)))
+    return TRACE_INVALID_ARGUMENT;
+  memcpy(&s3k_parity_config, config, sizeof(*config));
+  count = ((uint32_t)config->song_track_end - config->song_track_first
+    + (uint32_t)config->sfx_track_end - config->sfx_track_first) / config->track_size;
+  if (!count || count > S3K_PARITY_MAX_TRACKS)
+  { memset(&s3k_parity_config, 0, sizeof(s3k_parity_config)); return TRACE_ABI_OR_CONFIG_LIMIT; }
+  for (i = 0; i < config->descriptor_count; i++)
+  {
+    const struct gpgx_s3k_audio_parity_descriptor_v1 *descriptor = &descriptors[i];
+    if (!descriptor->descriptor_id || !descriptor->begin_pc || !descriptor->end_pc
+        || !descriptor->expected_service_kind
+        || (descriptor->expected_track_type != 1u
+          && descriptor->expected_track_type != 2u)
+        || descriptor->reserved0
+        || !bytes_are_zero((const uint8_t *)descriptor->reserved,
+          sizeof(descriptor->reserved))) goto invalid;
+    for (j = 0; j < i; j++)
+      if (descriptors[j].descriptor_id == descriptor->descriptor_id
+          || (descriptors[j].begin_pc == descriptor->begin_pc
+            && descriptors[j].begin_opcode == descriptor->begin_opcode)) goto invalid;
+  }
+  memcpy(s3k_parity_descriptors, descriptors,
+    config->descriptor_count * sizeof(descriptors[0]));
+  memset(s3k_parity_track_playing, 0, sizeof(s3k_parity_track_playing));
+  memset(s3k_parity_track_generation, 0, sizeof(s3k_parity_track_generation));
+  s3k_parity_fm_address = 0;
+  s3k_parity_fm_address_valid = 0;
+  memset(&s3k_parity_fault, 0, sizeof(s3k_parity_fault));
+  memset(&s3k_parity_active, 0, sizeof(s3k_parity_active));
+  s3k_parity_event_count_value = s3k_parity_omitted_count = 0;
+  s3k_parity_next_transaction_id = 0;
