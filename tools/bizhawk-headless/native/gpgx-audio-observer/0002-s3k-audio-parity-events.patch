+    return TRACE_INVALID_PHASE;
+  s3k_parity_event_count_value = s3k_parity_omitted_count = 0;
+  s3k_parity_runtime_error = s3k_parity_ready_drained = 0;
+  s3k_parity_vint_ordinal = vint_ordinal;
+  s3k_parity_last_service_token = 0;
+  s3k_parity_service_entry_master_cycle = 0;
