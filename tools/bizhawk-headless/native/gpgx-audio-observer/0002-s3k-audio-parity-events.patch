+ECL_EXPORT int32_t gpgx_s3k_audio_parity_drain(
+  struct gpgx_s3k_audio_parity_event_v1 *out,
+  uint32_t out_capacity, uint32_t *out_count)
+{
+  if (s3k_parity_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  if (!out_count) return TRACE_INVALID_ARGUMENT;
+  *out_count = s3k_parity_event_count_value;
+  if (s3k_parity_omitted_count) return TRACE_OVERFLOW;
+  if (s3k_parity_event_count_value && (!out
+      || out_capacity < s3k_parity_event_count_value))
+    return out ? TRACE_OUTPUT_CAPACITY : TRACE_INVALID_ARGUMENT;
+  if (!s3k_parity_event_count_value && (out || out_capacity))
+    return TRACE_INVALID_ARGUMENT;
+  if (s3k_parity_event_count_value)
+    memcpy(out, s3k_parity_events,
+      s3k_parity_event_count_value * sizeof(s3k_parity_events[0]));
+  s3k_parity_event_count_value = 0;
+  s3k_parity_phase = PHASE_CONFIGURED;
+  s3k_parity_ready_drained = 1;
+  return TRACE_OK;
+}
