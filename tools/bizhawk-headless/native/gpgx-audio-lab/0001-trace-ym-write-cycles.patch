 }
+
+static struct gpgx_audio_trace_event *new_ym_timing_lab_event(void)
+{
+  struct gpgx_audio_trace_event *event;
+  if (ym_timing_lab_phase != PHASE_RECORDING) return NULL;
+  if (ym_timing_lab_event_count >= GPGX_YM_TIMING_LAB_EVENT_CAPACITY)
+  {
+    if (ym_timing_lab_omitted_count != UINT32_MAX)
+      ym_timing_lab_omitted_count++;
+    ym_timing_lab_fault = GPGX_AUDIO_TRACE_FAULT_CAPACITY;
+    return NULL;
+  }
+  event = &ym_timing_lab_events[ym_timing_lab_event_count];
+  memset(event, 0, sizeof(*event));
+  event->ordinal = ym_timing_lab_event_count++;
+  event->kind = 24u;
+  return event;
+}
+
+void gpgx_ym_timing_lab_fm_write(uint32_t cycles, uint32_t address,
+  uint32_t data, uint32_t dma_stall_count)
+{
+  struct gpgx_audio_trace_event *event = new_ym_timing_lab_event();
+  uint32_t packed;
+  if (!event) return;
+  packed = ((address & 3u) << 8) | (data & 0xffu);
+  event->subject = 12u;
+  event->flags = 1u;
+  event->offset = dma_stall_count > UINT16_MAX
+    ? UINT16_MAX : (uint16_t)dma_stall_count;
+  event->payload_length = 8u;
+  memcpy(event->payload, &packed, 4u);
+  memcpy(event->payload + 4u, &cycles, 4u);
+}
+
+void gpgx_ym_timing_lab_fm_channel_sample(uint32_t channel, int32_t sample)
+{
+  struct gpgx_audio_trace_event *event;
+  if ((channel < 4u || channel > 6u)
+      && (channel < 8u || channel > 11u)) return;
+  event = new_ym_timing_lab_event();
+  if (!event) return;
+  event->subject = (uint16_t)channel;
+  event->payload_length = 4u;
+  memcpy(event->payload, &sample, 4u);
+}
+
+void gpgx_ym_timing_lab_sound_request(uint32_t sound_id, uint32_t fm_channel)
+{
+  struct gpgx_audio_trace_event *event = new_ym_timing_lab_event();
+  uint32_t packed;
+  if (!event) return;
+  packed = ((fm_channel & 0xffu) << 8) | (sound_id & 0xffu);
+  event->subject = 13u;
+  event->payload_length = 4u;
+  memcpy(event->payload, &packed, 4u);
+}
+
+void gpgx_ym_timing_lab_z80_instruction(uint32_t pc, uint32_t sound_id)
+{
+  if (ym_timing_lab_z80_admission_pc != 0u
+      && pc == ym_timing_lab_z80_admission_pc
+      && (sound_id & 0xffu) == ym_timing_lab_z80_admission_sound)
+    ym_timing_lab_z80_admission_pending = 1u;
+  if (ym_timing_lab_z80_admission_pending
+      && pc == ym_timing_lab_z80_group_start_pc)
+  {
+    gpgx_ym_timing_lab_sound_request(ym_timing_lab_z80_admission_sound,
+      ym_timing_lab_z80_admission_channel);
+    ym_timing_lab_z80_admission_pending = 0u;
+  }
+}
+
+ECL_EXPORT uint32_t gpgx_ym_timing_lab_event_size(void)
+{ return sizeof(struct gpgx_audio_trace_event); }
+
+ECL_EXPORT uint32_t gpgx_ym_timing_lab_capacity(void)
+{ return GPGX_YM_TIMING_LAB_EVENT_CAPACITY; }
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_begin_frame(void)
+{
+  if (ym_timing_lab_phase != PHASE_DISABLED) return TRACE_INVALID_PHASE;
+  ym_timing_lab_event_count = ym_timing_lab_omitted_count = 0;
+  ym_timing_lab_fault = gpgx_ym_timing_lab_dma_stall_count = 0;
+  ym_timing_lab_phase = PHASE_RECORDING;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_end_frame(void)
+{
+  if (ym_timing_lab_phase != PHASE_RECORDING) return TRACE_INVALID_PHASE;
+  ym_timing_lab_phase = PHASE_READY;
+  return ym_timing_lab_fault ? TRACE_OVERFLOW : TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_event_count(
+  uint32_t *required_count, uint32_t *overflow_count)
+{
+  if (ym_timing_lab_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  if (!required_count || !overflow_count) return TRACE_INVALID_ARGUMENT;
+  *required_count = ym_timing_lab_event_count;
+  *overflow_count = ym_timing_lab_omitted_count;
+  return ym_timing_lab_fault ? TRACE_OVERFLOW : TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_drain(
+  struct gpgx_audio_trace_event *out, uint32_t capacity,
+  uint32_t *drained_count)
+{
+  if (ym_timing_lab_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  if (!drained_count) return TRACE_INVALID_ARGUMENT;
+  *drained_count = ym_timing_lab_event_count;
+  if (ym_timing_lab_fault) return TRACE_OVERFLOW;
+  if (capacity < ym_timing_lab_event_count) return TRACE_OUTPUT_CAPACITY;
+  if (ym_timing_lab_event_count && !out) return TRACE_INVALID_ARGUMENT;
+  if (ym_timing_lab_event_count)
+    memcpy(out, ym_timing_lab_events,
+      ym_timing_lab_event_count * sizeof(ym_timing_lab_events[0]));
+  ym_timing_lab_event_count = 0;
+  ym_timing_lab_phase = PHASE_DISABLED;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_first_fault(uint32_t *fault)
+{
+  if (!fault) return TRACE_INVALID_ARGUMENT;
+  *fault = ym_timing_lab_fault;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_abort_frame(void)
+{
+  if (ym_timing_lab_phase != PHASE_RECORDING
+      && ym_timing_lab_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  ym_timing_lab_event_count = ym_timing_lab_omitted_count = 0;
+  ym_timing_lab_fault = gpgx_ym_timing_lab_dma_stall_count = 0;
+  ym_timing_lab_phase = PHASE_DISABLED;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_mark_sound_request(
+  uint32_t sound_id, uint32_t fm_channel)
+{
+  if (ym_timing_lab_phase != PHASE_RECORDING) return TRACE_INVALID_PHASE;
+  gpgx_ym_timing_lab_sound_request(sound_id, fm_channel);
+  return ym_timing_lab_fault ? TRACE_OVERFLOW : TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_configure_z80_admission(
+  uint32_t admission_pc, uint32_t group_start_pc,
+  uint32_t sound_id, uint32_t fm_channel)
+{
+  if (ym_timing_lab_phase != PHASE_DISABLED) return TRACE_INVALID_PHASE;
+  ym_timing_lab_z80_admission_pc = admission_pc;
+  ym_timing_lab_z80_group_start_pc = group_start_pc;
+  ym_timing_lab_z80_admission_sound = sound_id & 0xffu;
+  ym_timing_lab_z80_admission_channel = fm_channel & 0xffu;
+  ym_timing_lab_z80_admission_pending = 0u;
+  return TRACE_OK;
+}
