-void gpgx_audio_trace_fm_write(uint32_t address, uint32_t data)
-{ record_chip(EVENT_FM_WRITE, (uint16_t)(address & 3u), (uint8_t)data); }
+void gpgx_audio_trace_fm_write(uint32_t cycles, uint32_t address,
+  uint32_t data, uint32_t dma_stall_count)
+{
+  struct gpgx_audio_trace_event *event;
+  uint32_t packed;
+  if (trace_phase == PHASE_RECORDING)
+  {
+    event = new_event(24u);
+    if (!event) return;
+    packed = ((address & 3u) << 8) | (data & 0xffu);
+    event->subject = 12u;
+    event->flags = 1u;
+    event->offset = dma_stall_count > UINT16_MAX
+      ? UINT16_MAX : (uint16_t)dma_stall_count;
+    event->payload_length = 8u;
+    memcpy(event->payload, &packed, 4u);
+    memcpy(event->payload + 4u, &cycles, 4u);
+  }
+  if (!trace_depth) return;
+  record_chip(EVENT_FM_WRITE, (uint16_t)(address & 3u), (uint8_t)data);
+}
+
+void gpgx_audio_trace_fm_channel_sample(uint32_t channel, int32_t sample)
+{
+  struct gpgx_audio_trace_event *event;
+  if (trace_phase != PHASE_RECORDING ||
+      ((channel < 4u || channel > 6u)
+       && (channel < 8u || channel > 11u))) return;
+  event = new_event(24u);
+  if (!event) return;
+  event->subject = (uint16_t)channel;
+  event->payload_length = 4u;
+  memcpy(event->payload, &sample, 4u);
+}
 
 void gpgx_audio_trace_psg_write(uint32_t data)
-{ record_chip(EVENT_PSG_WRITE, 0, (uint8_t)data); }
+{
+  if (!trace_depth) return;
+  record_chip(EVENT_PSG_WRITE, 0, (uint8_t)data);
+}
 
