+static struct gpgx_audio_trace_event *new_ym_timing_lab_event(void)
+{
+  struct gpgx_audio_trace_event *event;
+  if (ym_timing_lab_phase != PHASE_RECORDING) return NULL;
+  if (ym_timing_lab_event_count >= GPGX_YM_TIMING_LAB_EVENT_CAPACITY)
+  {
+    if (ym_timing_lab_omitted_count != UINT32_MAX)
+      ym_timing_lab_omitted_count++;
+    ym_timing_lab_fault = GPGX_AUDIO_TRACE_FAULT_CAPACITY;
+    return NULL;
+  }
+  event = &ym_timing_lab_events[ym_timing_lab_event_count];
+  memset(event, 0, sizeof(*event));
+  event->ordinal = ym_timing_lab_event_count++;
+  event->kind = 24u;
+  return event;
+}
+
+static void emit_ym_timing_lab_context(void)
+{
+  uint32_t offset;
+  for (offset = 0; offset < ym_timing_lab_context_size; offset += 8u)
+  {
+    uint32_t count = ym_timing_lab_context_size - offset;
+    struct gpgx_audio_trace_event *event = new_ym_timing_lab_event();
+    if (!event) return;
+    if (count > 8u) count = 8u;
+    event->subject = 14u;
+    event->offset = (uint16_t)(offset / 8u);
+    event->flags = (offset == 0 ? 1u : 0u)
+      | (offset + count == ym_timing_lab_context_size ? 2u : 0u);
+    event->payload_length = (uint8_t)count;
+    memcpy(event->payload, ym_timing_lab_pre_group_context + offset, count);
+  }
+}
+
+static void emit_ym_timing_lab_attenuation(
+  uint8_t lane, const uint16_t attenuation[4])
+{
+  struct gpgx_audio_trace_event *event = new_ym_timing_lab_event();
+  if (!event) return;
+  event->subject = 15u;
+  event->flags = lane;
+  event->payload_length = 8u;
+  memcpy(event->payload, attenuation, 8u);
+}
+
+static void run_ym_timing_lab_samples(uint32_t count)
+{
+  int scratch[256 * 2];
+  while (count)
+  {
+    uint32_t batch = count > 256u ? 256u : count;
+    YM2612Update(scratch, (int)batch);
+    count -= batch;
+  }
+}
+
+static void replay_ym_timing_lab_group(
+  uint8_t timed, uint16_t attenuation[4])
+{
+  uint32_t i;
+  uint32_t frontier = ym_timing_lab_group_frontier_ahead;
+  YM2612LoadContext(ym_timing_lab_pre_group_context);
+  for (i = 0; i < ym_timing_lab_group_write_count; i++)
+  {
+    const struct ym_timing_group_write *write = &ym_timing_lab_group_writes[i];
+    uint32_t relative_cycle = write->relative_cycle;
+    if (timed && relative_cycle > frontier)
+    {
+      uint32_t samples = (relative_cycle - frontier
+        + YM_TIMING_CLOCK_RATIO - 1u) / YM_TIMING_CLOCK_RATIO;
+      run_ym_timing_lab_samples(samples);
+      frontier += samples * YM_TIMING_CLOCK_RATIO;
+    }
+    if (write->port == 0u && write->reg == 0x28u
+        && write->value == 0xf5u)
+    {
+      YM2612GetFm5Attenuation(attenuation);
+      return;
+    }
+    YM2612Write(write->port << 1, write->reg);
+    YM2612Write((write->port << 1) | 1u, write->value);
+  }
+  ym_timing_lab_fault = 0x7004u;
+}
+
+static uint32_t source_busy_until(uint32_t due)
+{
+  uint32_t ym_clock = due / 42u + (due % 42u ? 1u : 0u);
+  if (ym_clock > UINT32_MAX - 32u
+      || ym_clock + 32u > UINT32_MAX / 42u)
+  {
+    ym_timing_lab_fault = 0x700au;
+    return 0u;
+  }
+  return (ym_clock + 32u) * 42u;
+}
+
+static void replay_ym_timing_lab_source(
+  uint32_t residue, uint16_t attenuation[4])
+{
+  uint32_t i, program, due = residue, busy_until = 0u;
+  uint32_t frontier = ym_timing_lab_group_frontier_ahead;
+  if (ym_timing_lab_group_write_count == 30u) program = 0u;
+  else if (ym_timing_lab_group_write_count == 31u) program = 1u;
+  else { ym_timing_lab_fault = 0x700bu; return; }
+  if (ym_timing_lab_source_row_counts[program]
+      != ym_timing_lab_group_write_count)
+  { ym_timing_lab_fault = 0x700cu; return; }
+  YM2612LoadContext(ym_timing_lab_pre_group_context);
+  for (i = 0; i < ym_timing_lab_group_write_count; i++)
+  {
+    const struct ym_timing_source_row *row =
+      &ym_timing_lab_source_rows[program][i];
+    const struct ym_timing_group_write *write =
+      &ym_timing_lab_group_writes[i];
+    uint32_t status, loops = 0u;
+    if (write->port != row->port || write->reg != row->reg)
+    { ym_timing_lab_fault = 0x700du; return; }
+    if (i)
+    {
+      if (UINT32_MAX - due < row->fixed_cycles)
+      { ym_timing_lab_fault = 0x700au; return; }
+      status = due + row->fixed_cycles;
+      while (status < busy_until)
+      {
+        if (!row->busy_loop_cycles
+            || UINT32_MAX - status < row->busy_loop_cycles
+            || ++loops > 64u)
+        { ym_timing_lab_fault = 0x700au; return; }
+        status += row->busy_loop_cycles;
+      }
+      if (UINT32_MAX - status < row->ready_to_data_cycles)
+      { ym_timing_lab_fault = 0x700au; return; }
+      due = status + row->ready_to_data_cycles;
+    }
+    if (due > frontier)
+    {
+      uint32_t samples = (due - frontier
+        + YM_TIMING_CLOCK_RATIO - 1u) / YM_TIMING_CLOCK_RATIO;
+      run_ym_timing_lab_samples(samples);
+      frontier += samples * YM_TIMING_CLOCK_RATIO;
+    }
+    if (write->port == 0u && write->reg == 0x28u
+        && write->value == 0xf5u)
+    {
+      YM2612GetFm5Attenuation(attenuation);
+      return;
+    }
+    YM2612Write(write->port << 1, write->reg);
+    YM2612Write((write->port << 1) | 1u, write->value);
+    busy_until = source_busy_until(due);
+    if (ym_timing_lab_fault) return;
+  }
+  ym_timing_lab_fault = 0x7004u;
+}
+
+static void emit_ym_timing_lab_source_attenuation(
+  uint8_t residue, const uint16_t attenuation[4])
+{
+  struct gpgx_audio_trace_event *event = new_ym_timing_lab_event();
+  if (!event) return;
+  event->subject = 18u;
+  event->flags = residue;
+  event->payload_length = 8u;
+  memcpy(event->payload, attenuation, 8u);
+}
+
+static void evaluate_ym_timing_lab_group(void)
+{
+  uint16_t atomic[4] = {0, 0, 0, 0};
+  uint16_t timed[4] = {0, 0, 0, 0};
+  uint16_t source[4] = {0, 0, 0, 0};
+  uint32_t residue;
+  int size;
+  if (!YM2612Update || !YM2612Write || !YM2612LoadContext
+      || !YM2612SaveContext || !YM2612GetFm5Attenuation)
+  {
+    ym_timing_lab_fault = 0x7007u;
+    return;
+  }
+  size = YM2612SaveContext(ym_timing_lab_live_context);
+  if (size <= 0 || (uint32_t)size != ym_timing_lab_context_size)
+  {
+    ym_timing_lab_fault = 0x7005u;
+    return;
+  }
+  ym_timing_lab_suppress_samples = 1u;
+  replay_ym_timing_lab_group(0u, atomic);
+  replay_ym_timing_lab_group(1u, timed);
+  if (ym_timing_lab_source_row_counts[0]
+      || ym_timing_lab_source_row_counts[1])
+    for (residue = 0; residue < 42u && !ym_timing_lab_fault; residue++)
+    {
+      replay_ym_timing_lab_source(residue, source);
+      emit_ym_timing_lab_source_attenuation((uint8_t)residue, source);
+    }
+  YM2612LoadContext(ym_timing_lab_live_context);
+  ym_timing_lab_suppress_samples = 0u;
+  emit_ym_timing_lab_attenuation(1u, atomic);
+  emit_ym_timing_lab_attenuation(2u, timed);
+  ym_timing_lab_group_active = 0u;
+  ym_timing_lab_group_write_count = 0u;
+}
+
+void gpgx_ym_timing_lab_before_fm_write(uint32_t cycles,
+  uint32_t fm_frontier_cycles, uint32_t address, uint32_t data)
+{
+  uint32_t port = (address >> 1) & 1u;
+  uint32_t reg;
+  struct ym_timing_group_write *write;
+  if ((address & 1u) == 0u)
+  {
+    ym_timing_lab_address[port] = (uint8_t)data;
+    return;
+  }
+  if (!ym_timing_lab_context_pending && !ym_timing_lab_group_active) return;
+  reg = ym_timing_lab_address[port];
+  if (!ym_timing_lab_group_active)
+  {
+    int size;
+    if (!YM2612SaveContext)
+    {
+      ym_timing_lab_fault = 0x7007u;
+      return;
+    }
+    size = YM2612SaveContext(ym_timing_lab_pre_group_context);
+    if (size <= 0 || (uint32_t)size > YM_TIMING_CONTEXT_CAPACITY)
+    {
+      ym_timing_lab_fault = 0x7001u;
+      return;
+    }
+    ym_timing_lab_context_size = (uint32_t)size;
+    ym_timing_lab_group_first_cycle = cycles;
+    ym_timing_lab_group_frontier_ahead = fm_frontier_cycles - cycles;
+    ym_timing_lab_context_pending = 0u;
+    ym_timing_lab_group_active = 1u;
+    ym_timing_lab_group_write_count = 0u;
+    emit_ym_timing_lab_context();
+  }
+  if (ym_timing_lab_group_write_count >= YM_TIMING_GROUP_WRITE_CAPACITY)
+  {
+    ym_timing_lab_fault = 0x7002u;
+    return;
+  }
+  write = &ym_timing_lab_group_writes[ym_timing_lab_group_write_count++];
+  write->relative_cycle = cycles - ym_timing_lab_group_first_cycle;
+  write->port = (uint8_t)port;
+  write->reg = (uint8_t)reg;
+  write->value = (uint8_t)data;
+}
+
+void gpgx_ym_timing_lab_fm_write(uint32_t cycles, uint32_t address,
+  uint32_t data, uint32_t dma_stall_count)
+{
+  struct gpgx_audio_trace_event *event = new_ym_timing_lab_event();
+  uint32_t packed;
+  if (!event) return;
+  packed = ((address & 3u) << 8) | (data & 0xffu);
+  event->subject = 12u;
+  event->flags = 1u;
+  event->offset = dma_stall_count > UINT16_MAX
+    ? UINT16_MAX : (uint16_t)dma_stall_count;
+  event->payload_length = 8u;
+  memcpy(event->payload, &packed, 4u);
+  memcpy(event->payload + 4u, &cycles, 4u);
+  if ((address & 1u) && ((address >> 1) & 1u) == 0u
+      && ym_timing_lab_address[0] == 0x28u && (data & 0xffu) == 0xf5u
+      && ym_timing_lab_group_active)
+    evaluate_ym_timing_lab_group();
+}
+
+void gpgx_ym_timing_lab_fm_channel_sample(uint32_t channel, int32_t sample)
+{
+  struct gpgx_audio_trace_event *event;
+  if (ym_timing_lab_suppress_samples) return;
+  if ((channel < 4u || channel > 6u)
+      && (channel < 8u || channel > 11u)) return;
+  event = new_ym_timing_lab_event();
+  if (!event) return;
+  event->subject = (uint16_t)channel;
+  event->payload_length = 4u;
+  memcpy(event->payload, &sample, 4u);
+}
+
+void gpgx_ym_timing_lab_sound_request(uint32_t sound_id, uint32_t fm_channel)
+{
+  struct gpgx_audio_trace_event *event = new_ym_timing_lab_event();
+  uint32_t packed;
+  if (!event) return;
+  packed = ((fm_channel & 0xffu) << 8) | (sound_id & 0xffu);
+  event->subject = 13u;
+  event->payload_length = 4u;
+  memcpy(event->payload, &packed, 4u);
+  if (ym_timing_lab_context_pending || ym_timing_lab_group_active)
+  {
+    ym_timing_lab_fault = 0x7003u;
+    return;
+  }
+  ym_timing_lab_context_pending = 1u;
+}
+
+static void emit_ym_timing_lab_instruction(
+  uint8_t cpu, uint32_t pc, uint32_t cycles, uint16_t opcode)
+{
+  struct gpgx_audio_trace_event *event;
+  if ((ym_timing_lab_z80_admission_pc != 0u && cpu != 1u)
+      || (ym_timing_lab_z80_admission_pc == 0u && cpu != 2u)) return;
+  ym_timing_lab_instruction_calls++;
+  if (!ym_timing_lab_context_pending && !ym_timing_lab_group_active) return;
+  ym_timing_lab_instruction_eligible++;
+  event = new_ym_timing_lab_event();
+  if (!event) return;
+  event->subject = 16u;
+  event->flags = cpu;
+  event->pc = pc;
+  event->offset = opcode;
+  event->payload_length = cpu == 2u ? 8u : 4u;
+  memcpy(event->payload, &cycles, 4u);
+  if (cpu == 2u)
+    memcpy(event->payload + 4u, &ym_timing_lab_m68k_refresh_total, 4u);
+}
+
+void gpgx_ym_timing_lab_m68k_instruction(
+  uint32_t pc, uint32_t cycles, uint32_t opcode)
+{
+  emit_ym_timing_lab_instruction(2u, pc, cycles, (uint16_t)opcode);
+}
+
+void gpgx_ym_timing_lab_m68k_refresh(uint32_t master_cycles)
+{
+  if (UINT32_MAX - ym_timing_lab_m68k_refresh_total < master_cycles)
+  {
+    ym_timing_lab_fault = 0x7009u;
+    return;
+  }
+  ym_timing_lab_m68k_refresh_total += master_cycles;
+}
+
+void gpgx_ym_timing_lab_z80_instruction(
+  uint32_t pc, uint32_t cycles, uint32_t sound_id,
+  uint32_t owner_ix, uint32_t opcode)
+{
+  emit_ym_timing_lab_instruction(1u, pc, cycles, (uint16_t)(opcode & 0xffu));
+  if (ym_timing_lab_z80_admission_pc != 0u
+      && pc == ym_timing_lab_z80_admission_pc
+      && (sound_id & 0xffu) == ym_timing_lab_z80_admission_sound)
+    ym_timing_lab_z80_admission_pending = 1u;
+  if (ym_timing_lab_z80_admission_pending
+      && pc == ym_timing_lab_z80_group_start_pc)
+  {
+    if ((owner_ix & 0xffffu) == ym_timing_lab_z80_owner_ix)
+      gpgx_ym_timing_lab_sound_request(ym_timing_lab_z80_admission_sound,
+        ym_timing_lab_z80_admission_channel);
+    else
+      ym_timing_lab_fault = 0x7006u;
+    ym_timing_lab_z80_admission_pending = 0u;
+  }
+}
+
+ECL_EXPORT uint32_t gpgx_ym_timing_lab_event_size(void)
+{ return sizeof(struct gpgx_audio_trace_event); }
+
+ECL_EXPORT uint32_t gpgx_ym_timing_lab_capacity(void)
+{ return GPGX_YM_TIMING_LAB_EVENT_CAPACITY; }
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_begin_frame(void)
+{
+  if (ym_timing_lab_phase != PHASE_DISABLED) return TRACE_INVALID_PHASE;
+  ym_timing_lab_event_count = ym_timing_lab_omitted_count = 0;
+  ym_timing_lab_fault = gpgx_ym_timing_lab_dma_stall_count = 0;
+  ym_timing_lab_instruction_calls = ym_timing_lab_instruction_eligible = 0;
+  ym_timing_lab_m68k_refresh_total = 0;
+  ym_timing_lab_phase = PHASE_RECORDING;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_end_frame(void)
+{
+  struct gpgx_audio_trace_event *event;
+  if (ym_timing_lab_phase != PHASE_RECORDING) return TRACE_INVALID_PHASE;
+  event = new_ym_timing_lab_event();
+  if (event)
+  {
+    event->subject = 17u;
+    event->payload_length = 8u;
+    memcpy(event->payload, &ym_timing_lab_instruction_calls, 4u);
+    memcpy(event->payload + 4u, &ym_timing_lab_instruction_eligible, 4u);
+  }
+  ym_timing_lab_phase = PHASE_READY;
+  return ym_timing_lab_fault ? TRACE_OVERFLOW : TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_event_count(
+  uint32_t *required_count, uint32_t *overflow_count)
+{
+  if (ym_timing_lab_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  if (!required_count || !overflow_count) return TRACE_INVALID_ARGUMENT;
+  *required_count = ym_timing_lab_event_count;
+  *overflow_count = ym_timing_lab_omitted_count;
+  return ym_timing_lab_fault ? TRACE_OVERFLOW : TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_drain(
+  struct gpgx_audio_trace_event *out, uint32_t capacity,
+  uint32_t *drained_count)
+{
+  if (ym_timing_lab_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  if (!drained_count) return TRACE_INVALID_ARGUMENT;
+  *drained_count = ym_timing_lab_event_count;
+  if (ym_timing_lab_fault) return TRACE_OVERFLOW;
+  if (capacity < ym_timing_lab_event_count) return TRACE_OUTPUT_CAPACITY;
+  if (ym_timing_lab_event_count && !out) return TRACE_INVALID_ARGUMENT;
+  if (ym_timing_lab_event_count)
+    memcpy(out, ym_timing_lab_events,
+      ym_timing_lab_event_count * sizeof(ym_timing_lab_events[0]));
+  ym_timing_lab_event_count = 0;
+  ym_timing_lab_phase = PHASE_DISABLED;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_first_fault(uint32_t *fault)
+{
+  if (!fault) return TRACE_INVALID_ARGUMENT;
+  *fault = ym_timing_lab_fault;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_abort_frame(void)
+{
+  if (ym_timing_lab_phase != PHASE_RECORDING
+      && ym_timing_lab_phase != PHASE_READY) return TRACE_INVALID_PHASE;
+  ym_timing_lab_event_count = ym_timing_lab_omitted_count = 0;
+  ym_timing_lab_fault = gpgx_ym_timing_lab_dma_stall_count = 0;
+  ym_timing_lab_phase = PHASE_DISABLED;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_mark_sound_request(
+  uint32_t sound_id, uint32_t fm_channel)
+{
+  if (ym_timing_lab_phase != PHASE_RECORDING) return TRACE_INVALID_PHASE;
+  gpgx_ym_timing_lab_sound_request(sound_id, fm_channel);
+  return ym_timing_lab_fault ? TRACE_OVERFLOW : TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_configure_z80_admission(
+  uint32_t admission_pc, uint32_t group_start_pc,
+  uint32_t sound_id, uint32_t fm_channel, uint32_t owner_ix)
+{
+  if (ym_timing_lab_phase != PHASE_DISABLED) return TRACE_INVALID_PHASE;
+  ym_timing_lab_z80_admission_pc = admission_pc;
+  ym_timing_lab_z80_group_start_pc = group_start_pc;
+  ym_timing_lab_z80_admission_sound = sound_id & 0xffu;
+  ym_timing_lab_z80_admission_channel = fm_channel & 0xffu;
+  ym_timing_lab_z80_owner_ix = owner_ix & 0xffffu;
+  ym_timing_lab_z80_admission_pending = 0u;
+  return TRACE_OK;
+}
+
+ECL_EXPORT int32_t gpgx_ym_timing_lab_configure_source_row(
+  uint32_t program_kind, uint32_t row, uint32_t expected_port_register,
+  uint32_t fixed_cycles, uint32_t busy_loop_cycles,
+  uint32_t ready_to_data_cycles)
+{
+  struct ym_timing_source_row *target;
+  if (ym_timing_lab_phase != PHASE_DISABLED) return TRACE_INVALID_PHASE;
+  if (program_kind >= YM_TIMING_SOURCE_PROGRAMS
+      || row >= YM_TIMING_SOURCE_ROWS
+      || row != ym_timing_lab_source_row_counts[program_kind]
+      || (expected_port_register >> 8) > 1u
+      || (row == 0u && (fixed_cycles
+        || busy_loop_cycles || ready_to_data_cycles))
+      || (row != 0u && !busy_loop_cycles))
+    return TRACE_INVALID_ARGUMENT;
+  target = &ym_timing_lab_source_rows[program_kind][row];
+  target->fixed_cycles = fixed_cycles;
+  target->busy_loop_cycles = busy_loop_cycles;
+  target->ready_to_data_cycles = ready_to_data_cycles;
+  target->port = (uint8_t)(expected_port_register >> 8);
+  target->reg = (uint8_t)expected_port_register;
+  ym_timing_lab_source_row_counts[program_kind]++;
+  return TRACE_OK;
+}
