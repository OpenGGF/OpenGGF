# Copy to a protected operator directory outside the checkout; pass --env-file.
# This file contains paths and names, never token values.
IMAGE_PREFIX=openggf-racing
IMAGE_TAG=local
MASTER_HOSTNAME=racing.example.org
MASTER_BIND_IP=0.0.0.0
OPERATOR_DIR=/absolute/path/to/racing-operator
ROM_PATH='/absolute/path/to/your existing game.gen'
